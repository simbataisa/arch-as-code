        </HTTPSamplerProxy>
        <hashTree>

          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="extract-outbox-miscounted" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="script"><![CDATA[
import groovy.json.JsonSlurper

def json = new JsonSlurper().parseText(prev.getResponseDataAsString())
vars.put("outbox_miscounted", json.miscountedRows.toString())
]]></stringProp>
          </JSR223PostProcessor>
          <hashTree/>

        </hashTree>

        <!-- I3's own evidence: replays account_balance_report (the
             incrementally-refreshed projection) against a fresh
             SUM(amount_minor) GROUP BY account_id over ledger_entry itself
             (the replayed projection), counting any account whose balance
             disagrees (or is entirely missing from one side) as one
             field-level mismatch. The POST /reporting/refresh (final) call
             above already brought the projection current, so a healthy SUT
             reports zero drift here. -->
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Compute Replay Drift" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script"><![CDATA[
import java.sql.Connection
import java.sql.DriverManager

String url = System.getenv("LEDGER_JDBC_URL")
String user = System.getenv("LEDGER_JDBC_USER")
String password = System.getenv("LEDGER_JDBC_PASSWORD")

Map<Long, Long> reported = [:]
Map<Long, Long> replayed = [:]

Connection conn = DriverManager.getConnection(url, user, password)
try {
    def st = conn.createStatement()
    try {
        def reportRows = st.executeQuery("SELECT account_id, balance_minor FROM account_balance_report")
        while (reportRows.next()) {
            reported.put(reportRows.getLong("account_id"), reportRows.getLong("balance_minor"))
        }
        reportRows.close()

        def replayRows = st.executeQuery(
            "SELECT account_id, SUM(amount_minor) AS balance_minor FROM ledger_entry GROUP BY account_id")
        while (replayRows.next()) {
            replayed.put(replayRows.getLong("account_id"), replayRows.getLong("balance_minor"))
        }
        replayRows.close()
    } finally {
        st.close()
    }
} finally {
    conn.close()
}

Set<Long> everyAccountId = new HashSet<>()
everyAccountId.addAll(reported.keySet())
everyAccountId.addAll(replayed.keySet())

long drift = 0
for (Long accountId : everyAccountId) {
    Long reportedBalance = reported.get(accountId)
    Long replayedBalance = replayed.get(accountId)
    if (reportedBalance == null || replayedBalance == null || !reportedBalance.equals(replayedBalance)) {
        drift++
    }
}
vars.put("replay_drift", String.valueOf(drift))

SampleResult.setSuccessful(true)
SampleResult.setResponseData("replay_drift=" + drift + " (" + everyAccountId.size() + " accounts compared)", "UTF-8")
SampleResult.setResponseCode("200")
]]></stringProp>
        </JSR223Sampler>
        <hashTree/>

        <!-- assert-readmodel.groovy (this task's deliverable) evaluates
             I1-I4 and I6 against the props tallies from the sampling group
             and the vars this group's own samplers wrote above, emits I5 as
             not-evaluated, then calls the JVM EvidenceEmitter to write one
             fragment to traceability/runs/. -->
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="assert-readmodel" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename">${__groovy(System.getenv("ASSERT_SCRIPT_PATH"),)}</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script"></stringProp>
        </JSR223Sampler>
        <hashTree/>

      </hashTree>

    </hashTree>
  </hashTree>
</jmeterTestPlan>
