<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.2">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="TST-037 Read-Model Convergence and CDC Lag" enabled="true">
      <stringProp name="TestPlan.comments">Task 10 (Wave 17 QE Harness). See README.md for the invariants (I1-I6) this plan asserts -- I5 is reported not-evaluated, never substituted, and I6 is enforced structurally (a bounded number of samples, never a wait-for-convergence loop).</stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">true</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
        <collectionProp name="Arguments.arguments"/>
      </elementProp>
      <stringProp name="TestPlan.user_define_classpath"></stringProp>
    </TestPlan>
    <hashTree>

      <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Content-Type: application/json" enabled="true">
        <collectionProp name="HeaderManager.headers">
          <elementProp name="" elementType="Header">
            <stringProp name="Header.name">Content-Type</stringProp>
            <stringProp name="Header.value">application/json</stringProp>
          </elementProp>
        </collectionProp>
      </HeaderManager>
      <hashTree/>

      <!-- setUp Thread Group: resets the reporting fixture and seeds one
           account's ledger activity plus two pending outbox rows, before the
           Refresh and Sample Lag group's first request; same TRUNCATE ...
           RESTART IDENTITY CASCADE pattern reference-sut's own
           AbstractReportingIntegrationTest#resetReportingFixture() uses.
           outbox has no FK to account (see V4__outbox_and_reporting.sql), so
           it is truncated explicitly, not reached by the ledger CASCADE;
           necessary, not just tidy: GET /reporting/outbox counts every
           miscounted row in the whole table with no scoping to this run, so
           a prior defect-active run's stale rows would otherwise poison
           every later clean run's I4 result (same rationale TST-021's own
           setUp Thread Group documents for trial-balance). The two outbox
           rows are inserted directly via JDBC (there is no HTTP surface for
           enqueue() either) but left UNPUBLISHED here; the TearDown group
           below is what actually publishes them, over
           POST /reporting/publish, the one HTTP path into the defect-aware
           publishPending(). Also zeroes this run's own lag tallies, so a
           second run in the same SUT process (this module's own JUnit
           fixture running clean-then-defect) never mixes its samples with a
           previous run's leftovers (same idiom TST-023/TST-031's own setUp
           Thread Groups use for their own props). -->
      <SetupThreadGroup guiclass="SetupThreadGroupGui" testclass="SetupThreadGroup" testname="Seed Ledger Activity" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">stopthread</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">1</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">1</stringProp>
        <stringProp name="ThreadGroup.ramp_time">1</stringProp>
        <boolProp name="ThreadGroup.scheduler">false</boolProp>
        <stringProp name="ThreadGroup.duration"></stringProp>
        <stringProp name="ThreadGroup.delay"></stringProp>
      </SetupThreadGroup>
      <hashTree>

        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Reset and Seed Reporting Fixture" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script"><![CDATA[
import java.sql.Connection
import java.sql.DriverManager

String url = System.getenv("LEDGER_JDBC_URL")
String user = System.getenv("LEDGER_JDBC_USER")
String password = System.getenv("LEDGER_JDBC_PASSWORD")

Connection conn = DriverManager.getConnection(url, user, password)
try {
    def st = conn.createStatement()
    try {
        // outbox has no FK to account -- truncate it explicitly or a prior
        // run's published rows leak into this one's I4 verdict.
        st.executeUpdate("TRUNCATE TABLE outbox RESTART IDENTITY")
        st.executeUpdate("TRUNCATE TABLE report_refresh_timestamp, ledger_entry, account RESTART IDENTITY CASCADE")
        st.executeUpdate("INSERT INTO account (account_ref, party_name) VALUES ('ACC-000001', 'Test Fixture Reporting Co')")
        st.executeUpdate("INSERT INTO ledger_entry (transfer_ref, account_id, amount_minor) " +
            "SELECT gen_random_uuid(), id, 500 FROM account WHERE account_ref = 'ACC-000001'")
        st.executeUpdate("INSERT INTO ledger_entry (transfer_ref, account_id, amount_minor) " +
            "SELECT gen_random_uuid(), id, 250 FROM account WHERE account_ref = 'ACC-000001'")
        // Left unpublished (published_at IS NULL) -- the TearDown group's
        // POST /reporting/publish is what advances these, exercising the
        // one code path (ReportingService#publishPending) the
        // outbox-published-count-stale defect actually touches.
        st.executeUpdate("INSERT INTO outbox (event_type, aggregate_ref) VALUES ('acct-balance-changed', 'ACC-000001')")
        st.executeUpdate("INSERT INTO outbox (event_type, aggregate_ref) VALUES ('acct-balance-changed', 'ACC-000001')")
    } finally {
        st.close()
    }
} finally {
    conn.close()
}

// Cleared here, not just at process start, so a second run in the same SUT
// process (e.g. this module's own JUnit fixture running clean-then-defect)
// never adds its samples on top of a previous run's leftovers.
props.put("tst037_max_p95", "0")
props.put("tst037_max_p99", "0")
props.put("tst037_samples", "0")

SampleResult.setSuccessful(true)
SampleResult.setResponseData("reset outbox/report_refresh_timestamp/ledger_entry/account, seeded ACC-000001 and two pending outbox rows", "UTF-8")
SampleResult.setResponseCode("200")
]]></stringProp>
        </JSR223Sampler>
        <hashTree/>

      </hashTree>

      <!-- Main Thread Group: 4 threads x 3 loops (12 samples total),
           alternating POST /reporting/refresh with GET /reporting/lag and
           keeping the maximum observed p95/p99 in props. I6 is structural,
           not a timer: this plan never waits for convergence; it takes a
           BOUNDED number of samples and lets assert-readmodel.groovy fail
           the run if the bound is still breached by the time sampling
           stops. An indefinite "poll until converged" loop is exactly the
           behaviour I6 forbids. -->
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Refresh and Sample Lag" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">3</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">4</stringProp>
        <stringProp name="ThreadGroup.ramp_time">1</stringProp>
        <boolProp name="ThreadGroup.scheduler">false</boolProp>
        <stringProp name="ThreadGroup.duration"></stringProp>
        <stringProp name="ThreadGroup.delay"></stringProp>
      </ThreadGroup>
      <hashTree>

        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="POST /reporting/refresh" enabled="true">
          <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments"/>
          </elementProp>
          <stringProp name="HTTPSampler.domain">localhost</stringProp>
          <stringProp name="HTTPSampler.port">8080</stringProp>
          <stringProp name="HTTPSampler.protocol">http</stringProp>
          <stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp>
          <stringProp name="HTTPSampler.path">/reporting/refresh</stringProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <boolProp name="HTTPSampler.auto_redirects">false</boolProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp>
          <stringProp name="HTTPSampler.embedded_url_re"></stringProp>
          <stringProp name="HTTPSampler.connect_timeout">5000</stringProp>
          <stringProp name="HTTPSampler.response_timeout">10000</stringProp>
        </HTTPSamplerProxy>
        <hashTree/>

        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="GET /reporting/lag" enabled="true">
          <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments"/>
          </elementProp>
          <stringProp name="HTTPSampler.domain">localhost</stringProp>
          <stringProp name="HTTPSampler.port">8080</stringProp>
          <stringProp name="HTTPSampler.protocol">http</stringProp>
          <stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp>
          <stringProp name="HTTPSampler.path">/reporting/lag</stringProp>
          <stringProp name="HTTPSampler.method">GET</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <boolProp name="HTTPSampler.auto_redirects">false</boolProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp>
          <stringProp name="HTTPSampler.embedded_url_re"></stringProp>
          <stringProp name="HTTPSampler.connect_timeout">5000</stringProp>
          <stringProp name="HTTPSampler.response_timeout">10000</stringProp>
        </HTTPSamplerProxy>
        <hashTree>

          <!-- Raises the running maximum p95/p99 into props (JMeter's
               process-wide, cross-thread shared store; a JMeter *variable*
               is scoped per-thread and would silently undercount, each of
               the 4 threads seeing only its own slice) and increments the
               bounded sample counter I6 checks. synchronized(props) guards
               all three updates; 4 threads read/compare/write concurrently.
               No timer, no retry-until-converged loop here; exactly one
               observation per loop iteration, then the thread moves on. -->
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="sample-lag-maxima" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="script"><![CDATA[
import groovy.json.JsonSlurper

if ("200".equals(prev.getResponseCode())) {
    def json = new JsonSlurper().parseText(prev.getResponseDataAsString())
    long p95 = json.p95Ms as long
    long p99 = json.p99Ms as long
    synchronized (props) {
        long currentMaxP95 = Long.parseLong(props.getProperty("tst037_max_p95", "0"))
        if (p95 > currentMaxP95) {
            props.put("tst037_max_p95", String.valueOf(p95))
        }
        long currentMaxP99 = Long.parseLong(props.getProperty("tst037_max_p99", "0"))
        if (p99 > currentMaxP99) {
            props.put("tst037_max_p99", String.valueOf(p99))
        }
        long samples = Long.parseLong(props.getProperty("tst037_samples", "0"))
        props.put("tst037_samples", String.valueOf(samples + 1))
    }
}
]]></stringProp>
          </JSR223PostProcessor>
          <hashTree/>

        </hashTree>

      </hashTree>

      <!-- TearDown Thread Group: runs once, after every Refresh and Sample
           Lag thread has finished (JMeter guarantees this ordering). Calls
           POST /reporting/publish (the one HTTP path into the
           defect-aware publishPending()), so the two outbox rows setUp
           left pending are now actually published, exercising
           outbox-published-count-stale exactly the way every other
           module's own defect is exercised: over HTTP, never in-process
           and never via an environment variable on the SUT container. Then
           reads GET /reporting/outbox for I4's verdict, and compares a
           freshly-replayed projection against the incrementally-maintained
           one for I3. -->
      <PostThreadGroup guiclass="PostThreadGroupGui" testclass="PostThreadGroup" testname="Verify Convergence" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">1</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">1</stringProp>
        <stringProp name="ThreadGroup.ramp_time">1</stringProp>
        <boolProp name="ThreadGroup.scheduler">false</boolProp>
        <stringProp name="ThreadGroup.duration"></stringProp>
        <stringProp name="ThreadGroup.delay"></stringProp>
      </PostThreadGroup>
      <hashTree>

        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="POST /reporting/refresh (final)" enabled="true">
          <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments"/>
          </elementProp>
          <stringProp name="HTTPSampler.domain">localhost</stringProp>
          <stringProp name="HTTPSampler.port">8080</stringProp>
          <stringProp name="HTTPSampler.protocol">http</stringProp>
          <stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp>
          <stringProp name="HTTPSampler.path">/reporting/refresh</stringProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <boolProp name="HTTPSampler.auto_redirects">false</boolProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp>
          <stringProp name="HTTPSampler.embedded_url_re"></stringProp>
          <stringProp name="HTTPSampler.connect_timeout">5000</stringProp>
          <stringProp name="HTTPSampler.response_timeout">10000</stringProp>
        </HTTPSamplerProxy>
        <hashTree/>

        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="GET /reporting/lag (final)" enabled="true">
          <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments"/>
          </elementProp>
          <stringProp name="HTTPSampler.domain">localhost</stringProp>
          <stringProp name="HTTPSampler.port">8080</stringProp>
          <stringProp name="HTTPSampler.protocol">http</stringProp>
          <stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp>
          <stringProp name="HTTPSampler.path">/reporting/lag</stringProp>
          <stringProp name="HTTPSampler.method">GET</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <boolProp name="HTTPSampler.auto_redirects">false</boolProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp>
          <stringProp name="HTTPSampler.embedded_url_re"></stringProp>
          <stringProp name="HTTPSampler.connect_timeout">5000</stringProp>
          <stringProp name="HTTPSampler.response_timeout">10000</stringProp>
        </HTTPSamplerProxy>
        <hashTree>

          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="extract-final-lag" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="script"><![CDATA[
import groovy.json.JsonSlurper

def json = new JsonSlurper().parseText(prev.getResponseDataAsString())
vars.put("lag_p95Ms", json.p95Ms.toString())
vars.put("lag_p99Ms", json.p99Ms.toString())
vars.put("lag_boundMs", json.convergenceBoundMs.toString())
]]></stringProp>
          </JSR223PostProcessor>
          <hashTree/>

        </hashTree>

        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="POST /reporting/publish" enabled="true">
          <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments"/>
          </elementProp>
          <stringProp name="HTTPSampler.domain">localhost</stringProp>
          <stringProp name="HTTPSampler.port">8080</stringProp>
          <stringProp name="HTTPSampler.protocol">http</stringProp>
          <stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp>
          <stringProp name="HTTPSampler.path">/reporting/publish</stringProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
