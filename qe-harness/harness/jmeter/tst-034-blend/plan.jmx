      <!-- TearDown Thread Group: runs once, after every Journey Load
           thread (all four groups) has fully drained (same "assert after
           load has drained" rationale tst-021-ledger/plan.jmx's own
           TearDown documents). Finalizes the raw per-sample tallies into
           the derived values assert-blend.groovy reads (a sorted-reservoir
           p95, a per-sub-window minimum count, and the total sub-window
           count), then runs assert-blend.groovy itself. -->
      <PostThreadGroup guiclass="PostThreadGroupGui" testclass="PostThreadGroup" testname="Verify Blend" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">1</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">1</stringProp>
        <stringProp name="ThreadGroup.ramp_time">1</stringProp>
        <boolProp name="ThreadGroup.scheduler">false</boolProp>
        <stringProp name="ThreadGroup.duration"></stringProp>
        <stringProp name="ThreadGroup.delay"></stringProp>
      </PostThreadGroup>
      <hashTree>

        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Finalize Blend Tallies" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script"><![CDATA[
import com.techcombank.qe.harness.config.ProfileResolver

// Converts the raw per-sample tallies the four Journey Load groups'
// JSR223PostProcessors wrote (per-journey count/errors, a bounded latency
// reservoir, and per-sub-window counts) into the three derived values
// assert-blend.groovy actually reads. A sorted-reservoir p95 (bounded at
// RESERVOIR_SIZE samples per journey) rather than a per-sample recompute:
// sorting on every single sample would make a real multi-hour run
// pathologically slow, and this runs once, single-threaded, after every
// load thread has already drained.
final int RESERVOIR_SIZE = 300

ProfileResolver.Profile profile = new ProfileResolver().load("mixed")

int maxWindowSeen = Integer.parseInt(props.getProperty("tst034_max_window_idx_seen", "-1"))
props.put("tst034_sub_windows", String.valueOf(maxWindowSeen + 1))

Map<String, Long> worstPerTier = [:]

profile.journeys().each { name, journey ->
    long latencyN = Long.parseLong(props.getProperty("tst034_" + name + "_latency_n", "0"))
    int sampleCount = (int) Math.min(latencyN, (long) RESERVOIR_SIZE)
    List<Long> latencies = []
    for (int i = 0; i < sampleCount; i++) {
        latencies.add(Long.parseLong(props.getProperty("tst034_" + name + "_latency_" + i, "0")))
    }
    latencies.sort()
    long p95 = 0L
    if (!latencies.isEmpty()) {
        int idx = (int) Math.ceil(0.95d * latencies.size()) - 1
        idx = Math.max(0, Math.min(idx, latencies.size() - 1))
        p95 = latencies.get(idx)
    }
    props.put("tst034_" + name + "_p95", String.valueOf(p95))

    String tier = journey.tier().toLowerCase()
    long currentWorst = worstPerTier.containsKey(tier) ? worstPerTier.get(tier) : 0L
    worstPerTier.put(tier, Math.max(currentWorst, p95))

    // tst034_<name>_min_window_count is already computed incrementally by
    // this journey's own tally-blend PostProcessor (an O(1)-key running
    // minimum across every CLOSED sub-window; see that script's own
    // comment) -- nothing left to derive here. Its absence (a journey that
    // never got a single measured sample) is exactly the "0" default
    // assert-blend.groovy itself falls back to, correctly reading as total
    // starvation, so it is deliberately not defaulted here either.
}

worstPerTier.each { tier, worst ->
    props.put("tst034_worst_p95_" + tier, String.valueOf(worst))
}

SampleResult.setSuccessful(true)
SampleResult.setResponseData("finalized blend tallies for " + profile.journeys().keySet(), "UTF-8")
SampleResult.setResponseCode("200")
]]></stringProp>
        </JSR223Sampler>
        <hashTree/>

        <!-- assert-blend.groovy (this task's own deliverable) evaluates
             I1-I5 against the finalized tallies above, decides threshold
             evaluation from HarnessConfig.smokeMode(), and calls the JVM
             EvidenceEmitter to write one fragment to traceability/runs/. -->
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="assert-blend" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename">${__groovy(System.getenv("ASSERT_SCRIPT_PATH"),)}</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script"></stringProp>
        </JSR223Sampler>
        <hashTree/>

      </hashTree>

    </hashTree>
  </hashTree>
</jmeterTestPlan>
