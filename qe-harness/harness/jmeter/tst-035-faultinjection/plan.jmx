<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.2">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="TST-035 Fault Injection and Degraded Response" enabled="true">
      <stringProp name="TestPlan.comments">Task 18 (Wave 16 QE Harness). See README.md for the invariants (I1-I3) this plan asserts and for why the restore step in the TearDown Thread Group runs unconditionally, before the assertion step.</stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">true</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
        <collectionProp name="Arguments.arguments"/>
      </elementProp>
      <stringProp name="TestPlan.user_define_classpath"></stringProp>
    </TestPlan>
    <hashTree>

      <!-- setUp Thread Group: injects the Toxiproxy fault BEFORE the main
           Thread Group's first request, then computes how many load
           iterations to run (HarnessConfig.smokeMode() shortens this for
           CI, same "shorten duration, never weaken correctness" rule
           TST-031's plan.jmx documents) and zeroes this run's tallies,
           same reason TST-031 zeroes its own props: a second run in the
           same SUT process (this module's own JUnit fixture running
           clean-then-defect) must never add its tallies on top of a
           previous run's leftovers. on_sample_error=stopthread: a failed
           fault injection must stop the run loudly rather than let the
           main load proceed against a healthy, un-faulted downstream. -->
      <SetupThreadGroup guiclass="SetupThreadGroupGui" testclass="SetupThreadGroup" testname="Inject Downstream Fault" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">stopthread</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">1</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">1</stringProp>
        <stringProp name="ThreadGroup.ramp_time">1</stringProp>
        <boolProp name="ThreadGroup.scheduler">false</boolProp>
        <stringProp name="ThreadGroup.duration"></stringProp>
        <stringProp name="ThreadGroup.delay"></stringProp>
      </SetupThreadGroup>
      <hashTree>

        <!-- toxic-control.groovy (Task 18 deliverable), parameters="inject".
             Loaded by absolute path derived from ASSERT_SCRIPT_PATH's own
             parent directory (both files live in this same module
             directory) rather than a second dedicated env var: run-jmeter.sh
             (shared, unmodified) already exports ASSERT_SCRIPT_PATH for
             every JMeter module, so this reuses it instead of asking that
             shared script to know about a file only this module has. -->
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="inject-fault" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename">${__groovy(new File(System.getenv("ASSERT_SCRIPT_PATH")).getParent() + "/toxic-control.groovy",)}</stringProp>
          <stringProp name="parameters">inject</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script"></stringProp>
        </JSR223Sampler>
        <hashTree/>

        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Record Load Shape and Reset Tallies" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script"><![CDATA[
import com.techcombank.qe.harness.config.HarnessConfig

boolean smoke = HarnessConfig.smokeMode()
// Correctness (I1-I3, evaluated identically either way) is never
// conditional on smoke mode -- only how many times the main Thread Group
// calls GET /quotes/Q1 while the fault is active. Both figures are well
// above BreakerBehaviourTest's own breakerMinimumCalls + BREAKER_SLACK
// (5 + 2 = 7, from application.yml's minimumNumberOfCalls: 5), so either
// run genuinely drives the breaker through OPEN before the TearDown Thread
// Group removes the fault, not just observes a single failed call.
int loadIterations = smoke ? 8 : 12

props.put("tst035_smoke_mode", String.valueOf(smoke))
props.put("tst035_load_iterations", String.valueOf(loadIterations))
// Cleared here, not just at process start, so a second run in the same SUT
// process (e.g. this module's own JUnit fixture running clean-then-defect)
// never adds its tallies on top of a previous run's leftovers -- same
// reason TST-031's plan.jmx zeroes its own props in this same thread group.
props.put("tst035_total_calls", "0")
props.put("tst035_total_5xx", "0")
props.put("tst035_shape_violations", "0")

SampleResult.setSuccessful(true)
SampleResult.setResponseData("smoke=" + smoke + " loadIterations=" + loadIterations, "UTF-8")
SampleResult.setResponseCode("200")
]]></stringProp>
        </JSR223Sampler>
        <hashTree/>

      </hashTree>

      <!-- Main Thread Group: single thread, sequential calls; there is no
           throughput/concurrency invariant here (I1-I3 are all correctness
           checks), and a single caller keeps the tally arithmetic below
           trivial to reason about (no cross-thread interleaving to worry
           about, unlike TST-031's 25-thread rate load). Every call happens
           while the fault injected above is still active; the TearDown
           Thread Group below is the only place it gets removed. -->
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Fault Load" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">${__groovy(props.get("tst035_load_iterations"),)}</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">1</stringProp>
        <stringProp name="ThreadGroup.ramp_time">1</stringProp>
        <boolProp name="ThreadGroup.scheduler">false</boolProp>
        <stringProp name="ThreadGroup.duration"></stringProp>
        <stringProp name="ThreadGroup.delay"></stringProp>
      </ThreadGroup>
      <hashTree>

        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="GET /quotes/Q1" enabled="true">
          <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments"/>
          </elementProp>
          <stringProp name="HTTPSampler.domain">localhost</stringProp>
          <stringProp name="HTTPSampler.port">8080</stringProp>
          <stringProp name="HTTPSampler.protocol">http</stringProp>
          <stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp>
          <stringProp name="HTTPSampler.path">/quotes/Q1</stringProp>
          <stringProp name="HTTPSampler.method">GET</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <boolProp name="HTTPSampler.auto_redirects">false</boolProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp>
          <stringProp name="HTTPSampler.embedded_url_re"></stringProp>
          <stringProp name="HTTPSampler.connect_timeout">5000</stringProp>
          <stringProp name="HTTPSampler.response_timeout">10000</stringProp>
        </HTTPSamplerProxy>
        <hashTree>

          <!-- Tallies every response into props (process-wide, shared with
               the TearDown Thread Group below), same idiom TST-031's own
               tally-accept-reject uses, and for the same reason: a JMeter
               *variable* would be scoped to this one thread and would work
               here too since there is only one thread, but props is what
               assert-degradation.groovy (running in a DIFFERENT thread
               group) can actually read). I1: any 5xx is a violation. I2:
               any 200 response whose degraded/source pairing does not
               match DegradedResponse's own two constructors (degraded=true
               to source=="cache", degraded=false to source=="live") is a
               violation, evaluated here with the same logic
               assert-degradation.groovy's own recovery poll re-applies to
               the calls it makes after the fault is removed. -->
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="tally-response" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="script"><![CDATA[
import groovy.json.JsonSlurper

int code = prev.getResponseCode().isInteger() ? prev.getResponseCode().toInteger() : 0

synchronized (props) {
    long totalCalls = Long.parseLong(props.getProperty("tst035_total_calls", "0"))
    props.put("tst035_total_calls", String.valueOf(totalCalls + 1))

    if (code >= 500) {
        long total5xx = Long.parseLong(props.getProperty("tst035_total_5xx", "0"))
        props.put("tst035_total_5xx", String.valueOf(total5xx + 1))
    } else if (code == 200) {
        def json = new JsonSlurper().parseText(prev.getResponseDataAsString())
        boolean degraded = json.degraded
        String source = json.source
        boolean shapeOk = degraded ? (source == "cache") : (source == "live")
        if (!shapeOk) {
            long shapeViolations = Long.parseLong(props.getProperty("tst035_shape_violations", "0"))
            props.put("tst035_shape_violations", String.valueOf(shapeViolations + 1))
        }
    }
}
]]></stringProp>
          </JSR223PostProcessor>
          <hashTree/>

        </hashTree>

      </hashTree>

      <!-- TearDown Thread Group: runs once, after every Fault Load thread
           has finished. "restore-downstream" is FIRST and unconditional:
           it runs whether every load call above passed or failed (JMeter
           guarantees this thread group starts once the main Thread Group's
           threads have completed, regardless of their sample results, as
           long as nothing called stoptestnow; the Fault Load Thread Group's
           own on_sample_error=continue never does), so the Toxiproxy
           fault this run injected is always removed before this plan exits,
           never left to corrupt a later run against the same long-lived
           container. See README.md's "Guaranteed restore" section and
           Tst035ModuleTest#restoresTheProxyEvenWhenAssertionsFail, which
           proves exactly this by forcing a run that fails I1
           (breaker-disabled) and then checking the proxy is still clean
           afterward. assert-degradation (Task 18 deliverable) runs second,
           after the fault is already gone; it performs the I3 recovery
           poll itself (see that file's own header comment for why) and
           evaluates I1/I2 against the Fault Load Thread Group's tallies. -->
      <PostThreadGroup guiclass="PostThreadGroupGui" testclass="PostThreadGroup" testname="Restore Downstream and Verify Recovery" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">1</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">1</stringProp>
        <stringProp name="ThreadGroup.ramp_time">1</stringProp>
        <boolProp name="ThreadGroup.scheduler">false</boolProp>
        <stringProp name="ThreadGroup.duration"></stringProp>
        <stringProp name="ThreadGroup.delay"></stringProp>
      </PostThreadGroup>
      <hashTree>

        <!-- toxic-control.groovy, parameters="remove". Unconditional: see
             the PostThreadGroup-level comment above. -->
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="restore-downstream" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename">${__groovy(new File(System.getenv("ASSERT_SCRIPT_PATH")).getParent() + "/toxic-control.groovy",)}</stringProp>
          <stringProp name="parameters">remove</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script"></stringProp>
        </JSR223Sampler>
        <hashTree/>

        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="assert-degradation" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename">${__groovy(System.getenv("ASSERT_SCRIPT_PATH"),)}</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script"></stringProp>
        </JSR223Sampler>
        <hashTree/>

      </hashTree>

    </hashTree>
  </hashTree>
</jmeterTestPlan>
