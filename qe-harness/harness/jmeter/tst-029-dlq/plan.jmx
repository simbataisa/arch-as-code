          <stringProp name="script"><![CDATA[
// Cleared here, not just at process start, so a second run in the same SUT
// process (e.g. this module's own JUnit fixture running clean-then-defect)
// never adds its tallies on top of a previous run's leftovers -- same idiom
// TST-023/026/027/028/031's own setUp Thread Groups use for their own props.
props.put("tst029_poison_submitted", "0")
props.put("tst029_ordinary_submitted", "0")
props.put("tst029_max_poison_attempts", "0")
props.put("tst029_jobs_behind_poison", "0")

SampleResult.setSuccessful(true)
SampleResult.setResponseData("reset delivery state, zeroed tst029_* tallies", "UTF-8")
SampleResult.setResponseCode("200")
]]></stringProp>
        </JSR223Sampler>
