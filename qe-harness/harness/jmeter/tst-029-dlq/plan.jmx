      </hashTree>

      <!-- Main Thread Group: 6 threads x 3 loops = eighteen independent
           submissions. "Choose Job Or Poison" below assigns each of the
           eighteen (threadNum, iteration) slots a role purely as a
           function of a deterministic slot number and the declared
           alertDepth read in setUp - enough poison jobs to push DLQ depth
           at least two past dlqAlertDepth (I5), and exactly one ordinary
           job in the very next slot after the poison run (I3's
           non-blocking clause). Every other slot is an ordinary job. -->
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Submit Work and Poison" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">3</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">6</stringProp>
        <stringProp name="ThreadGroup.ramp_time">1</stringProp>
        <boolProp name="ThreadGroup.scheduler">false</boolProp>
        <stringProp name="ThreadGroup.duration"></stringProp>
        <stringProp name="ThreadGroup.delay"></stringProp>
      </ThreadGroup>
      <hashTree>

        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Choose Job Or Poison" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script"><![CDATA[
// (threadNum 0..5) * 3 + (iteration 1..3) -> a unique integer 1..18 for
// every one of this thread group's own eighteen slots -- no shared counter
// to race the way TST-027's own "Select Sequence And Role" needs one,
// since threadNum/iteration alone already identify exactly one physical
// execution slot apiece (same reasoning TST-028's own "assign-role-and-
// tally-correlation" comment gives for its own role assignment).
int slot = ctx.getThreadNum() * 3 + vars.getIteration()

long alertDepth = Long.parseLong(props.getProperty("tst029_dlq_alert_depth", "5"))
// Two past the declared threshold, not merely one, so I5's own
// observedDepth > alertDepth check is never a coin-flip on the exact
// boundary under ordinary scheduling jitter.
long poisonTarget = alertDepth + 2

String role
String jobId
boolean poison

if (slot <= poisonTarget) {
    // Poison run: slots 1..poisonTarget. Job ids are hyphenated short
    // forms (poison-0001), never a numeric id wide enough to trip gate
    // check 5 (13-19 consecutive digits) -- see README.md.
    role = "poison"
    poison = true
    jobId = String.format("poison-%04d", slot)
} else if (slot == poisonTarget + 1) {
    // The one ordinary job this plan deliberately submits in the very next
    // slot after the poison run -- every thread ramps within the same
    // one-second window, so this genuinely lands in qe.q.work alongside
    // the poison run rather than only after every one of them has already
    // settled. I3's own non-blocking clause: if a poison message anywhere
    // in qe.q.work were able to block the queue, this job's own state
    // change would never settle within "Poll Delivery State Until
    // Settled"'s bounded deadline in the TearDown group below.
    role = "behindPoison"
    poison = false
    jobId = String.format("job-%04d", slot)
} else {
    role = "normal"
    poison = false
    jobId = String.format("job-%04d", slot)
}

// Cross-thread tallies (a JMeter *variable* is scoped per-thread and would
// silently undercount) -- same idiom TST-023/026/028's own PostProcessors
// use for their own admission/correlation tallies.
synchronized (props) {
    String key = poison ? "tst029_poison_submitted" : "tst029_ordinary_submitted"
    long count = Long.parseLong(props.getProperty(key, "0"))
    props.put(key, String.valueOf(count + 1))
}

vars.put("jobId", jobId)
vars.put("poison", String.valueOf(poison))
vars.put("tst029_role", role)
]]></stringProp>
        </JSR223PreProcessor>
        <hashTree/>

        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="POST /messaging/work" enabled="true">
          <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments"/>
          </elementProp>
          <stringProp name="HTTPSampler.domain">localhost</stringProp>
          <stringProp name="HTTPSampler.port">8080</stringProp>
          <stringProp name="HTTPSampler.protocol">http</stringProp>
          <stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp>
          <stringProp name="HTTPSampler.path">/messaging/work?jobId=${jobId}&amp;poison=${poison}</stringProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <boolProp name="HTTPSampler.auto_redirects">false</boolProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp>
          <stringProp name="HTTPSampler.embedded_url_re"></stringProp>
          <stringProp name="HTTPSampler.connect_timeout">5000</stringProp>
          <stringProp name="HTTPSampler.response_timeout">10000</stringProp>
        </HTTPSamplerProxy>
        <hashTree/>

      </hashTree>

      <!-- TearDown Thread Group: runs once, after every "Submit Work and
           Poison" thread has finished (JMeter guarantees this ordering,
           and TestPlan.serialize_threadgroups above makes it explicit). -->
      <PostThreadGroup guiclass="PostThreadGroupGui" testclass="PostThreadGroup" testname="Verify Delivery" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">1</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">1</stringProp>
        <stringProp name="ThreadGroup.ramp_time">1</stringProp>
        <boolProp name="ThreadGroup.scheduler">false</boolProp>
        <stringProp name="ThreadGroup.duration"></stringProp>
        <stringProp name="ThreadGroup.delay"></stringProp>
      </PostThreadGroup>
      <hashTree>

        <!-- Bounded (30s: generous headroom past the retry ladder's own
             declared 13s = 1s+3s+9s rungs) poll of the conservation-law
             counters until submitted == stateChanges + dlqCount - never
             an indefinite wait on a broker that never settles. -->
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Poll Delivery State Until Settled" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script"><![CDATA[
import groovy.json.JsonSlurper
import java.net.URI
import java.net.http.HttpClient
import java.net.http.HttpRequest
import java.net.http.HttpResponse
import java.time.Duration
import java.time.Instant

String sutBaseUrl = System.getenv().getOrDefault("SUT_BASE_URL", "http://localhost:8080")
HttpClient http = HttpClient.newBuilder().connectTimeout(Duration.ofSeconds(5)).build()

long ordinarySubmitted = Long.parseLong(props.getProperty("tst029_ordinary_submitted", "0"))

Instant deadline = Instant.now().plusSeconds(30)
def state = null
boolean settled = false
while (Instant.now().isBefore(deadline)) {
    HttpRequest request = HttpRequest.newBuilder(URI.create(sutBaseUrl + "/messaging/delivery/state"))
        .timeout(Duration.ofSeconds(5))
        .GET()
        .build()
    HttpResponse<String> response = http.send(request, HttpResponse.BodyHandlers.ofString())
    state = new JsonSlurper().parseText(response.body())
    long submitted = state.submitted as long
    long stateChanges = state.stateChanges as long
    long dlqCount = state.dlqCount as long
    if (submitted == stateChanges + dlqCount) {
        settled = true
        break
    }
    Thread.sleep(500L)
}

long finalStateChanges = (state?.stateChanges ?: 0) as long
int maxAttempts = (state?.maxDeliveryAttempts ?: 0) as int

// I3/I6 need each poison message's own attempt count, but
// DeliveryService.attemptsFor(jobId) has no REST surface at all -- its own
// javadoc says it is "kept public so the SUT's own test can assert the
// boundary without going through HTTP". An HTTP-only module has no way to
// read a per-message attempt count directly, the same gap TST-028's own
// README documents for AggregatorService.awaitAggregate. qe.q.work's own
// x-delivery-limit queue argument (MessagingTopology) is declared AS
// maxDeliveryAttempts, so RabbitMQ itself -- not this module -- is what
// structurally prevents any message from ever being delivered more times
// than that. Once this poll confirms every poison message reached the DLQ
// rather than hanging mid-retry (settled == true), that ceiling has
// already held; this records the DECLARED value the broker enforced, not
// a count this module derived independently.
props.put("tst029_max_poison_attempts", String.valueOf(maxAttempts))

// I3's non-blocking clause: "behindPoison"'s own job (see "Choose Job Or
// Poison") is one of ordinarySubmitted; if it -- or any ordinary job --
// were stuck behind a poison message that never releases the queue,
// stateChanges would never catch up to ordinarySubmitted within this
// bounded poll.
long jobsBehindPoison = (settled && finalStateChanges >= ordinarySubmitted) ? 1L : 0L
props.put("tst029_jobs_behind_poison", String.valueOf(jobsBehindPoison))

SampleResult.setSuccessful(settled)
SampleResult.setResponseData("settled=${settled} submitted=${state?.submitted} stateChanges=${finalStateChanges} dlqCount=${state?.dlqCount}", "UTF-8")
SampleResult.setResponseCode(settled ? "200" : "500")
]]></stringProp>
        </JSR223Sampler>
        <hashTree/>

        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="GET /messaging/delivery/state" enabled="true">
          <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments"/>
          </elementProp>
          <stringProp name="HTTPSampler.domain">localhost</stringProp>
          <stringProp name="HTTPSampler.port">8080</stringProp>
          <stringProp name="HTTPSampler.protocol">http</stringProp>
