          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp>
          <stringProp name="HTTPSampler.embedded_url_re"></stringProp>
          <stringProp name="HTTPSampler.connect_timeout">5000</stringProp>
          <stringProp name="HTTPSampler.response_timeout">10000</stringProp>
        </HTTPSamplerProxy>
        <hashTree>

          <!-- assert-dlq.groovy reads this exact var for I1/I4's own
               declared-config fields. -->
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="capture-delivery-state" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="script"><![CDATA[
vars.put("delivery_state", prev.getResponseDataAsString())
]]></stringProp>
          </JSR223PostProcessor>
          <hashTree/>

        </hashTree>

        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="GET /messaging/dlq/depth" enabled="true">
          <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments"/>
          </elementProp>
          <stringProp name="HTTPSampler.domain">localhost</stringProp>
          <stringProp name="HTTPSampler.port">8080</stringProp>
          <stringProp name="HTTPSampler.protocol">http</stringProp>
          <stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp>
          <stringProp name="HTTPSampler.path">/messaging/dlq/depth</stringProp>
          <stringProp name="HTTPSampler.method">GET</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <boolProp name="HTTPSampler.auto_redirects">false</boolProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp>
          <stringProp name="HTTPSampler.embedded_url_re"></stringProp>
          <stringProp name="HTTPSampler.connect_timeout">5000</stringProp>
          <stringProp name="HTTPSampler.response_timeout">10000</stringProp>
        </HTTPSamplerProxy>
        <hashTree>

          <!-- assert-dlq.groovy reads this exact var for I5's own
               exported/alertFiring/alertDepth/depth fields. -->
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="capture-dlq-info" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="script"><![CDATA[
vars.put("dlq_info", prev.getResponseDataAsString())
]]></stringProp>
          </JSR223PostProcessor>
          <hashTree/>

        </hashTree>

        <!-- The ONLY step in this entire plan that ever touches the broker
             container, and the reason coverage stays "full" rather than
             "partial": I2 is genuinely implemented, just run-gated. Guarded
             by HarnessConfig.smokeMode() so Tst029ModuleTest (which always
             sets HARNESS_SMOKE_MODE=true) can never restart a developer's
             running stack; see README.md and this plan's own TestPlan-level
             comment. -->
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Restart Broker And Recheck DLQ (full runs only)" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script"><![CDATA[
import com.techcombank.qe.harness.config.HarnessConfig
import groovy.json.JsonSlurper
import java.io.File
import java.net.URI
import java.net.http.HttpClient
import java.net.http.HttpRequest
import java.net.http.HttpResponse
import java.nio.file.Path
import java.nio.file.Paths
import java.time.Duration
import java.time.Instant
import java.util.concurrent.TimeUnit

// HarnessConfig.smokeMode() -- not a raw System.getenv(...) == "true"
// comparison -- is this harness's single source of truth for smoke-mode
// detection (already used inline by tst-031/tst-034/tst-035's own plan.jmx,
// and by this module's own assert-dlq.groovy): it treats "true"/"1"/"yes"/
// "on" (case-insensitive, trimmed) as truthy. A raw exact-match check here
// could disagree with it -- e.g. HARNESS_SMOKE_MODE=1 would read as "not
// smoke" by a raw == "true" check and let this sampler actually restart
// the broker, while assert-dlq.groovy would still (correctly) report I2 as
// not-evaluated, discarding the outcome of a restart that just happened
// for no reason. Matching the established convention exactly closes that.
if (HarnessConfig.smokeMode()) {
    // I2 is reported not-evaluated by assert-dlq.groovy in this case --
    // dlq_depth_before_restart/dlq_depth_after_restart deliberately stay
    // unset, and the assertion script only ever reads them on the
    // non-smoke branch. This is the ONE branch Tst029ModuleTest's own
    // smoke-mode runs always take.
    SampleResult.setSuccessful(true)
    SampleResult.setResponseData("smoke mode: broker restart skipped -- I2 reported not-evaluated", "UTF-8")
    SampleResult.setResponseCode("200")
    return
}

String sutBaseUrl = System.getenv().getOrDefault("SUT_BASE_URL", "http://localhost:8080")
HttpClient http = HttpClient.newBuilder().connectTimeout(Duration.ofSeconds(5)).build()

// ASSERT_SCRIPT_PATH (set by bin/run-jmeter.sh) is this module's own
// absolute assert-dlq.groovy path, e.g.
// <repo>/qe-harness/harness/jmeter/tst-029-dlq/assert-dlq.groovy -- walk up
// from it to find the qe-harness/ directory containing docker-compose.yml,
// rather than trusting this JSR223 sampler's own JVM working directory
// (jmeter-maven-plugin documents no guarantee about it).
Path assertScript = Paths.get(System.getenv("ASSERT_SCRIPT_PATH")).toAbsolutePath()
Path qeHarnessRoot = assertScript
while (qeHarnessRoot != null && qeHarnessRoot.getFileName()?.toString() != "qe-harness") {
    qeHarnessRoot = qeHarnessRoot.getParent()
}
if (qeHarnessRoot == null) {
    throw new IllegalStateException("could not locate qe-harness/ walking up from " + assertScript)
}
File qeHarnessDir = qeHarnessRoot.toFile()

// Fresh, immediately-pre-restart read -- close enough to dlq_info (already
// captured a moment ago in this same TearDown group) that either would do,
// but reading again right here removes any doubt about what "before"
// means.
HttpRequest beforeReq = HttpRequest.newBuilder(URI.create(sutBaseUrl + "/messaging/dlq/depth"))
    .timeout(Duration.ofSeconds(5)).GET().build()
HttpResponse<String> beforeResp = http.send(beforeReq, HttpResponse.BodyHandlers.ofString())
def beforeJson = new JsonSlurper().parseText(beforeResp.body())
long depthBefore = beforeJson.depth as long
vars.put("dlq_depth_before_restart", String.valueOf(depthBefore))

// The real thing: restart ONLY the broker service -- never `down`, never a
// bare `docker compose restart` of the whole stack, which would also
// cycle reference-sut and postgres for no reason this invariant needs.
ProcessBuilder restartPb = new ProcessBuilder("docker", "compose", "restart", "broker")
restartPb.directory(qeHarnessDir)
restartPb.redirectErrorStream(true)
Process restartProcess = restartPb.start()
String restartOutput = restartProcess.getInputStream().getText("UTF-8")
boolean restartFinished = restartProcess.waitFor(60, TimeUnit.SECONDS)
if (!restartFinished) {
    restartProcess.destroyForcibly()
    throw new IllegalStateException("docker compose restart broker did not finish within 60s")
}
if (restartProcess.exitValue() != 0) {
    throw new IllegalStateException("docker compose restart broker failed: " + restartOutput)
}

// Bounded wait for the SAME check docker-compose.yml's own healthcheck
// uses (rabbitmq-diagnostics -q ping) -- never an indefinite wait on a
// broker that never comes back.
Instant healthDeadline = Instant.now().plusSeconds(60)
boolean healthy = false
while (Instant.now().isBefore(healthDeadline)) {
    ProcessBuilder pingPb = new ProcessBuilder(
        "docker", "compose", "exec", "-T", "broker", "rabbitmq-diagnostics", "-q", "ping")
    pingPb.directory(qeHarnessDir)
    pingPb.redirectErrorStream(true)
    Process pingProcess = pingPb.start()
    // Drain, never close-without-reading: closing this pipe out from under
    // a still-writing child risks a broken-pipe write on its side, which
    // can abort it with a misleading non-zero/hung exit rather than the
    // ping's own true result.
    String pingOutput = pingProcess.getInputStream().getText("UTF-8")
    boolean pingFinished = pingProcess.waitFor(10, TimeUnit.SECONDS)
    if (pingFinished && pingProcess.exitValue() == 0) {
        healthy = true
        break
    }
    if (!pingFinished) {
        pingProcess.destroyForcibly()
    }
    Thread.sleep(2000L)
}
if (!healthy) {
    throw new IllegalStateException("broker did not report healthy within 60s of the restart")
}

// The SUT's own Spring AMQP connections recover automatically once the
// broker is back, but that recovery is itself unbounded from this
// script's point of view -- retry the depth re-read on its own bounded
// deadline rather than trusting the very first call right after the
// broker reports healthy.
Instant reconnectDeadline = Instant.now().plusSeconds(30)
Long depthAfter = null
while (Instant.now().isBefore(reconnectDeadline)) {
    try {
        HttpRequest afterReq = HttpRequest.newBuilder(URI.create(sutBaseUrl + "/messaging/dlq/depth"))
            .timeout(Duration.ofSeconds(5)).GET().build()
        HttpResponse<String> afterResp = http.send(afterReq, HttpResponse.BodyHandlers.ofString())
        if (afterResp.statusCode() == 200) {
            def afterJson = new JsonSlurper().parseText(afterResp.body())
            depthAfter = afterJson.depth as long
            break
        }
    } catch (IOException ignored) {
        // SUT still reconnecting to the restarted broker; retry within budget.
    }
    Thread.sleep(1000L)
}
if (depthAfter == null) {
    throw new IllegalStateException("SUT did not reconnect to the restarted broker within 30s")
}
vars.put("dlq_depth_after_restart", String.valueOf(depthAfter))

SampleResult.setSuccessful(true)
SampleResult.setResponseData("broker restarted: depthBefore=${depthBefore} depthAfter=${depthAfter}", "UTF-8")
SampleResult.setResponseCode("200")
]]></stringProp>
