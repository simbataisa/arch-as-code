            <stringProp name="Header.value">application/json</stringProp>
          </elementProp>
        </collectionProp>
      </HeaderManager>
      <hashTree/>

      <!-- setUp Thread Group: resets the ledger AND idempotency tables (the
           latter has no FK to account, so the ledger's own TRUNCATE ...
           CASCADE below never reaches it - truncated explicitly, first),
           seeds the two fixture accounts, zeroes this run's own tst020_*
           tallies (same idiom TST-021/023/026/027/028/029/031's own setUp
           Thread Groups use for their own props - necessary because this
           module's own JUnit fixture runs clean-then-defect in the same SUT
           process), and - the one addition this task's own correction to
           the original brief makes - resets DeliveryService's own
           in-memory counters via POST /messaging/delivery/reset, so I7's
           own stateChanges read below can never be polluted by TST-029's
           own module (Task 24) having run against this same long-lived SUT
           process earlier. -->
      <SetupThreadGroup guiclass="SetupThreadGroupGui" testclass="SetupThreadGroup" testname="Reset Idempotency Fixture" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">stopthread</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">1</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">1</stringProp>
        <stringProp name="ThreadGroup.ramp_time">1</stringProp>
        <boolProp name="ThreadGroup.scheduler">false</boolProp>
        <stringProp name="ThreadGroup.duration"></stringProp>
        <stringProp name="ThreadGroup.delay"></stringProp>
      </SetupThreadGroup>
      <hashTree>

        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Reset and Seed Ledger + Idempotency Fixture" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script"><![CDATA[
import java.sql.Connection
import java.sql.DriverManager

String url = System.getenv("LEDGER_JDBC_URL")
String user = System.getenv("LEDGER_JDBC_USER")
String password = System.getenv("LEDGER_JDBC_PASSWORD")

Connection conn = DriverManager.getConnection(url, user, password)
try {
    def st = conn.createStatement()
    try {
        // idempotency_key has no FK to account, so the ledger's own
        // TRUNCATE ... CASCADE below never reaches it -- truncate it
        // explicitly, first, as its own statement.
        st.executeUpdate("TRUNCATE TABLE idempotency_key RESTART IDENTITY")
        st.executeUpdate("TRUNCATE TABLE ledger_entry, account RESTART IDENTITY CASCADE")
        st.executeUpdate("INSERT INTO account (account_ref, party_name) VALUES ('ACC-000001', 'Test Fixture Debtor Co')")
        st.executeUpdate("INSERT INTO account (account_ref, party_name) VALUES ('ACC-000002', 'Test Fixture Creditor Co')")
    } finally {
        st.close()
    }
} finally {
    conn.close()
}

// Cleared here, not just at process start, so a second run in the same SUT
// process (e.g. this module's own JUnit fixture running clean-then-defect)
// never adds its own tallies on top of a previous run's leftovers -- same
// idiom TST-021/023/026/027/028/029/031's own setUp Thread Groups use for
// their own props.
props.put("tst020_distinct_bodies", "0")
props.put("tst020_created_responses", "0")
props.put("tst020_replay_responses", "0")
props.put("tst020_burst_size", "12")
props.put("tst020_seen_bodies", "")

SampleResult.setSuccessful(true)
SampleResult.setResponseData("reset idempotency_key/ledger_entry/account, seeded ACC-000001/ACC-000002, zeroed tst020_* tallies", "UTF-8")
SampleResult.setResponseCode("200")
]]></stringProp>
        </JSR223Sampler>
        <hashTree/>

        <!-- Corrected Step 6 addition: zeroes DeliveryService's own
             submitted/stateChanges/dlqCount/attempts/seenJobIds counters,
             which otherwise persist across module runs in this same
             long-lived SUT process (e.g. TST-029's own module, Task 24,
             having already run against it) and would leak into I7's own
             stateChanges == 1 read below. -->
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="POST /messaging/delivery/reset" enabled="true">
          <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments"/>
          </elementProp>
          <stringProp name="HTTPSampler.domain">localhost</stringProp>
          <stringProp name="HTTPSampler.port">8080</stringProp>
          <stringProp name="HTTPSampler.protocol">http</stringProp>
          <stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp>
          <stringProp name="HTTPSampler.path">/messaging/delivery/reset</stringProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <boolProp name="HTTPSampler.auto_redirects">false</boolProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp>
          <stringProp name="HTTPSampler.embedded_url_re"></stringProp>
          <stringProp name="HTTPSampler.connect_timeout">5000</stringProp>
          <stringProp name="HTTPSampler.response_timeout">10000</stringProp>
        </HTTPSamplerProxy>
        <hashTree/>

      </hashTree>

      <!-- Main Thread Group: twelve threads, one shared Idempotency-Key,
           released together by the Synchronizing Timer below so I5's race
           is genuine rather than sequential - the unique constraint on
           idempotency_key.idempotency_key is what arbitrates exactly one
           winner (see IdempotencyService's own javadoc), not this plan. -->
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Same-Key Burst" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">1</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">12</stringProp>
        <stringProp name="ThreadGroup.ramp_time">1</stringProp>
        <boolProp name="ThreadGroup.scheduler">false</boolProp>
        <stringProp name="ThreadGroup.duration"></stringProp>
        <stringProp name="ThreadGroup.delay"></stringProp>
      </ThreadGroup>
      <hashTree>

        <SyncTimer guiclass="TestBeanGUI" testclass="SyncTimer" testname="Synchronizing Timer" enabled="true">
          <intProp name="groupSize">12</intProp>
          <longProp name="timeoutInMs">10000</longProp>
        </SyncTimer>
        <hashTree/>

        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="POST /transfers (shared Idempotency-Key)" enabled="true">
          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments">
              <elementProp name="" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">{"from":"ACC-000001","to":"ACC-000002","amountMinor":500}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
          <stringProp name="HTTPSampler.domain">localhost</stringProp>
          <stringProp name="HTTPSampler.port">8080</stringProp>
          <stringProp name="HTTPSampler.protocol">http</stringProp>
          <stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp>
          <stringProp name="HTTPSampler.path">/transfers</stringProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <boolProp name="HTTPSampler.auto_redirects">false</boolProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp>
          <stringProp name="HTTPSampler.embedded_url_re"></stringProp>
          <stringProp name="HTTPSampler.connect_timeout">5000</stringProp>
          <stringProp name="HTTPSampler.response_timeout">10000</stringProp>
        </HTTPSamplerProxy>
        <hashTree>

          <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Idempotency-Key: idem-burst-0001" enabled="true">
            <collectionProp name="HeaderManager.headers">
              <elementProp name="" elementType="Header">
                <stringProp name="Header.name">Idempotency-Key</stringProp>
                <stringProp name="Header.value">idem-burst-0001</stringProp>
              </elementProp>
            </collectionProp>
          </HeaderManager>
          <hashTree/>

          <!-- Cross-thread tallies (a JMeter *variable* is scoped per-thread
               and would silently undercount) - same idiom TST-023/026/028/
               029's own PostProcessors use for their own cross-thread
               tallies. synchronized(props) because twelve threads land here
               at (as near as SyncTimer can guarantee) the same instant. -->
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="tally-burst-response" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="script"><![CDATA[
synchronized (props) {
    String code = prev.getResponseCode()
    if ("201".equals(code)) {
        long c = Long.parseLong(props.getProperty("tst020_created_responses", "0"))
        props.put("tst020_created_responses", String.valueOf(c + 1))
    } else if ("200".equals(code)) {
        long c = Long.parseLong(props.getProperty("tst020_replay_responses", "0"))
        props.put("tst020_replay_responses", String.valueOf(c + 1))
    }

    // Accumulate distinct response bodies as a "|||"-delimited list in a
    // single String prop -- props (unlike vars) has no native collection
    // type, and this plan's own tst020_* idiom already keeps every tally as
    // a plain String for the same reason. A genuine dedup (I1/I2) means
    // every thread here observes the SAME winner's response body, so this
    // list should end up holding exactly one entry.
    String body = prev.getResponseDataAsString()
    String seen = props.getProperty("tst020_seen_bodies", "")
    List<String> entries = seen.isEmpty() ? new ArrayList<String>() : new ArrayList<String>(Arrays.asList(seen.split(java.util.regex.Pattern.quote("|||"))))
    if (!entries.contains(body)) {
        entries.add(body)
        props.put("tst020_seen_bodies", entries.join("|||"))
    }
    props.put("tst020_distinct_bodies", String.valueOf(entries.size()))
}
]]></stringProp>
          </JSR223PostProcessor>
          <hashTree/>

        </hashTree>

      </hashTree>

      <!-- TearDown Thread Group: runs once, after every Same-Key Burst
           thread has finished. Single thread, single loop - exercises the
           remaining invariants directly rather than under load. -->
      <PostThreadGroup guiclass="PostThreadGroupGui" testclass="PostThreadGroup" testname="Verify Idempotency" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">1</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">1</stringProp>
        <stringProp name="ThreadGroup.ramp_time">1</stringProp>
        <boolProp name="ThreadGroup.scheduler">false</boolProp>
        <stringProp name="ThreadGroup.duration"></stringProp>
        <stringProp name="ThreadGroup.delay"></stringProp>
      </PostThreadGroup>
      <hashTree>

        <!-- 1. I1's own verdict: total ledger_entry rows after the burst.
             A genuine dedup means exactly one transfer committed -> one
             balanced debit/credit pair -> 2 rows. -->
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Count ledger_entry After Burst" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script"><![CDATA[
import java.sql.Connection
import java.sql.DriverManager

String url = System.getenv("LEDGER_JDBC_URL")
String user = System.getenv("LEDGER_JDBC_USER")
String password = System.getenv("LEDGER_JDBC_PASSWORD")

long count
Connection conn = DriverManager.getConnection(url, user, password)
try {
    def rs = conn.createStatement().executeQuery("SELECT COUNT(*) FROM ledger_entry")
    rs.next()
    count = rs.getLong(1)
} finally {
    conn.close()
}

vars.put("entries_after_burst", String.valueOf(count))

SampleResult.setSuccessful(true)
SampleResult.setResponseData("entries_after_burst=${count}", "UTF-8")
SampleResult.setResponseCode("200")
]]></stringProp>
        </JSR223Sampler>
        <hashTree/>

