             5a. Submit job-idem-0001 once. -->
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="POST /messaging/work (first delivery)" enabled="true">
          <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
