        <!-- entries_after_distinct_keys is the DELTA these three distinct-key
             transfers alone contributed - (total now) minus
             entries_after_burst - not the running total, which would also
             include the burst's own 2 rows and break I3's own
             entriesAfterDistinctKeys == distinctKeysSent * 2L check in
             assert-idempotency.groovy. -->
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Count ledger_entry After Distinct Keys" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script"><![CDATA[
import java.sql.Connection
import java.sql.DriverManager

String url = System.getenv("LEDGER_JDBC_URL")
String user = System.getenv("LEDGER_JDBC_USER")
String password = System.getenv("LEDGER_JDBC_PASSWORD")

long total
Connection conn = DriverManager.getConnection(url, user, password)
try {
    def rs = conn.createStatement().executeQuery("SELECT COUNT(*) FROM ledger_entry")
    rs.next()
    total = rs.getLong(1)
} finally {
    conn.close()
}

long entriesAfterBurst = Long.parseLong(vars.get("entries_after_burst"))
long delta = total - entriesAfterBurst

vars.put("entries_after_distinct_keys", String.valueOf(delta))
vars.put("distinct_keys_sent", "3")

SampleResult.setSuccessful(true)
SampleResult.setResponseData("entries_after_distinct_keys=${delta} (total=${total}, afterBurst=${entriesAfterBurst})", "UTF-8")
SampleResult.setResponseCode("200")
]]></stringProp>
        </JSR223Sampler>
