<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    Standalone Spring Boot project, deliberately NOT a module of
    qe-harness/harness/pom.xml (qe-harness-parent). The reference SUT is
    independent of the harness modules that drive HTTP requests against it
    (Tasks 16-23 run as separate tool processes, e.g. JMeter/Karate/Locust/k6,
    against an already-running `docker compose up` container — see Task 14).
  -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <!-- Pinned per qe-harness/README.md "Pinned Versions" table. Do not float
         this without updating that table — a controller ruling downgraded the
         initially-resolved 4.1.1 to 3.5.16 for ecosystem compatibility with
         Resilience4j/Testcontainers/Spring Security needed by later tasks. -->
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>com.techcombank.qe</groupId>
  <artifactId>reference-sut</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>qe-harness-reference-sut</name>
  <description>
    Reference SUT for the QE Harness (Wave 16): a deliberately
    defect-toggleable Spring Boot service exercising the 24 testing
    archetypes (TST-020..TST-043) catalogued in the Wave 15 testing corpus.
  </description>

  <properties>
    <java.version>21</java.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>

    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>

    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>

    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Testcontainers: version is managed transitively via
         spring-boot-dependencies (the grandparent of this POM's
         spring-boot-starter-parent), which imports org.testcontainers:
         testcontainers-bom at 1.21.4 for Spring Boot 3.5.16 — see
         qe-harness/README.md "Pinned Versions" table for how that number
         was resolved. Task 6 is the first task in this repo to need a real
         Postgres for tests (CHECK constraints, transactions), so it
         introduces these two test-scoped Testcontainers dependencies.
         (spring-boot-testcontainers / @ServiceConnection is not used here —
         the test wires its own DataSource and runs Flyway directly, rather
         than booting a full Spring ApplicationContext.) -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>

      <!-- java.net.preferIPv4Stack=true: without this, SyntheticDataSeederTest
           (Task 6) is flaky when run alongside the rest of the suite on a
           non-Docker-Desktop engine (observed on Rancher Desktop). Testcontainers
           resolves the "localhost" it connects to for a container's mapped port,
           and when the JVM tries "::1" first but the engine's port-forwarder only
           listens on 127.0.0.1, the connection is refused rather than retried.
           Forcing IPv4-first resolution is harmless on Docker Desktop and fixes
           the flake everywhere else. See qe-harness/README.md's Testcontainers
           row for the DOCKER_HOST / Ryuk notes this does NOT cover. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <argLine>-Djava.net.preferIPv4Stack=true</argLine>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
