<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    Standalone Spring Boot project, deliberately NOT a module of
    qe-harness/harness/pom.xml (qe-harness-parent). The reference SUT is
    independent of the harness modules that drive HTTP requests against it
    (Tasks 16-23 run as separate tool processes, e.g. JMeter/Karate/Locust/k6,
    against an already-running `docker compose up` container — see Task 14).
  -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <!-- Pinned per qe-harness/README.md "Pinned Versions" table. Do not float
         this without updating that table — a controller ruling downgraded the
         initially-resolved 4.1.1 to 3.5.16 for ecosystem compatibility with
         Resilience4j/Testcontainers/Spring Security needed by later tasks. -->
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>com.techcombank.qe</groupId>
  <artifactId>reference-sut</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>qe-harness-reference-sut</name>
  <description>
    Reference SUT for the QE Harness (Wave 16): a deliberately
    defect-toggleable Spring Boot service exercising the 24 testing
    archetypes (TST-020..TST-043) catalogued in the Wave 15 testing corpus.
  </description>

  <properties>
    <java.version>21</java.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>

    <!-- TST-040 AuthN/AuthZ (Task 9). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>

    <!-- TST-035 circuit breaker (Task 11). resilience4j-spring-boot3 pulls in
         resilience4j-spring6 (the @CircuitBreaker annotation + Spring Boot
         autoconfiguration binding resilience4j.circuitbreaker.instances.* from
         application.yml) and resilience4j-circuitbreaker transitively. Not
         managed by spring-boot-dependencies' BOM, so (like jjwt-*/springdoc
         above) an explicit version is required. 2.4.0 resolved from Maven
         Central's maven-metadata.xml on 2026-08-25 as the current latest
         release, compatible with Spring Boot 3.x (resilience4j-spring-boot3
         has no Spring Boot version constraint of its own; verified its POM
         only depends on resilience4j-spring6 and spring-boot-starter, both
         version-ranges satisfied by the pinned 3.5.16). -->
    <dependency>
      <groupId>io.github.resilience4j</groupId>
      <artifactId>resilience4j-spring-boot3</artifactId>
      <version>2.4.0</version>
    </dependency>

    <!-- TST-035 circuit breaker (Task 11): resilience4j's @CircuitBreaker is
         woven via a Spring AOP proxy (CircuitBreakerAspect); without this
         starter, AopAutoConfiguration never activates and the annotation on
         DownstreamClient.fetch is silently ignored. Version managed by
         spring-boot-dependencies (verified via `mvn -N help:effective-pom`),
         so no explicit <version>, same pattern as spring-boot-starter-web. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-aop</artifactId>
    </dependency>

    <!-- JJWT: not managed by Spring Boot's spring-boot-dependencies BOM, so (like
         org.postgresql:postgresql below) an explicit version is required here.
         0.13.0 resolved from Maven Central's maven-metadata.xml on 2026-08-25 as
         the current latest release — see qe-harness/README.md "Pinned Versions". -->
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-api</artifactId>
      <version>0.13.0</version>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-impl</artifactId>
      <version>0.13.0</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-jackson</artifactId>
      <version>0.13.0</version>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>

    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>

    <!-- Explicit version override: Boot 3.5.16's spring-boot-dependencies BOM
         manages this to 42.7.11, vulnerable to CVE-2026-54291 (silent SCRAM
         channel-binding downgrade, fixed in 42.7.12). Pinned to 42.7.13 (the
         current release, per pgJDBC's own changelog) to match the same
         coordinate's version already used by qe-harness-jmeter's
         testPlanLibraries block. -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <version>42.7.13</version>
      <scope>runtime</scope>
    </dependency>

    <!-- TST-030 versioned API (Task 10): publishes GET /openapi.json (see
         OpenApiConfig) by introspecting the running Spring MVC controllers.
         Anticipated by qe-harness/README.md's "Pinned Versions" table as a
         Spring Boot 3.5.16-compatible dependency needed by a later task; not
         managed by spring-boot-dependencies' BOM, so (like jjwt-* and
         org.postgresql:postgresql above) an explicit version is required.
         2.9.0 resolved from Maven Central's maven-metadata.xml on
         2026-08-25 as the newest release on the 2.x line — the true latest,
         3.1.0, targets Spring Boot 4 and was not evaluated against this
         repo's pinned 3.5.16. webmvc-api (not -ui): only the JSON document
         is needed here, not a browsable Swagger UI. -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-api</artifactId>
      <version>2.9.0</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- TST-030 versioned API (Task 10): SchemaCompatibilityTest validates
         /v1/transfers and /v2/transfers responses against their published
         JSON Schema fixtures (src/main/resources/contracts/) with this
         library's JsonSchemaFactory/JsonSchema/ValidationMessage API. Not
         managed by spring-boot-dependencies' BOM, so (like the springdoc
         dependency above) an explicit version is required.

         1.5.9, NOT the true latest release (3.0.7, resolved from
         maven-metadata.xml on 2026-08-25) — 2.0.0 replaced the
         JsonSchemaFactory/JsonSchema/ValidationMessage API this task's
         given test code calls with an incompatible Schema/Error-based
         rewrite (verified directly: `unzip -l` on both the 3.0.7 and 2.0.7
         jars shows neither contains a ValidationMessage, SpecVersion,
         JsonSchema, or JsonSchemaFactory class at all). 1.5.9 is the newest
         release still on the 1.x line and the newest release that actually
         provides the API this SUT's test code needs. Test-scoped: no
         main-code path uses it. -->
    <dependency>
      <groupId>com.networknt</groupId>
      <artifactId>json-schema-validator</artifactId>
      <version>1.5.9</version>
      <scope>test</scope>
    </dependency>

    <!-- TST-040 AuthN/AuthZ (Task 9): MockMvc + Spring Security integration
         (SecurityMockMvcConfigurer) for the @WebMvcTest slices below. -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Testcontainers: version is managed transitively via
         spring-boot-dependencies (the grandparent of this POM's
         spring-boot-starter-parent), which imports org.testcontainers:
         testcontainers-bom at 1.21.4 for Spring Boot 3.5.16 — see
         qe-harness/README.md "Pinned Versions" table for how that number
         was resolved. Task 6 is the first task in this repo to need a real
         Postgres for tests (CHECK constraints, transactions), so it
         introduces these two test-scoped Testcontainers dependencies.
         (spring-boot-testcontainers / @ServiceConnection is not used here —
         the test wires its own DataSource and runs Flyway directly, rather
         than booting a full Spring ApplicationContext.) -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>

      <!-- java.net.preferIPv4Stack=true: without this, SyntheticDataSeederTest
           (Task 6) is flaky when run alongside the rest of the suite on a
           non-Docker-Desktop engine (observed on Rancher Desktop). Testcontainers
           resolves the "localhost" it connects to for a container's mapped port,
           and when the JVM tries "::1" first but the engine's port-forwarder only
           listens on 127.0.0.1, the connection is refused rather than retried.
           Forcing IPv4-first resolution is harmless on Docker Desktop and fixes
           the flake everywhere else. See qe-harness/README.md's Testcontainers
           row for the DOCKER_HOST / Ryuk notes this does NOT cover. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <argLine>-Djava.net.preferIPv4Stack=true</argLine>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
